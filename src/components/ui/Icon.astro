---
/**
 * DS: Icon. Material Symbols Outlined, Weight 300 – als Inline-SVG statt Webfont (WEB-Q3).
 * `filled` markiert ausschließlich aktive Zustände.
 * Namen in Iconify-Schreibweise mit Bindestrich, z. B. `calendar-month`.
 */
import icons from '@iconify-json/material-symbols-light/icons.json';
import { getIconData, iconToSVG } from '@iconify/utils';

interface Props {
  name: string;
  size?: number;
  filled?: boolean;
  /** Zugänglicher Name; ohne Label ist das Icon dekorativ. */
  label?: string;
  class?: string;
}

const { name, size = 24, filled = false, label, class: className } = Astro.props;

const data =
  (!filled && getIconData(icons, `${name}-outline`)) || getIconData(icons, name) || undefined;
if (!data) {
  throw new Error(`Icon "${name}" existiert nicht in material-symbols-light.`);
}
const svg = iconToSVG(data, { width: size, height: size });
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  {...svg.attributes}
  class:list={['bb-icon', className]}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={svg.body}
/>

<style>
  .bb-icon {
    flex: 0 0 auto;
  }
</style>
