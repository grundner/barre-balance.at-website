---
/** DS: Timeline. Abgeschlossen: gefüllter Teal-Punkt; laufend: Teal-Ring. */
interface Item {
  time: string;
  title: string;
  meta?: string;
  state: 'done' | 'ongoing';
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ol class:list={['timeline', className]}>
  {items.map((item) => (
    <li class:list={['timeline__item', `timeline__item--${item.state}`]}>
      <span class="timeline__time">{item.time}</span>
      <span class="timeline__rail" aria-hidden="true">
        <span class="timeline__dot" />
        <span class="timeline__line" />
      </span>
      <span class="timeline__body">
        <span class="timeline__title">{item.title}</span>
        {item.meta && <span class="timeline__meta">{item.meta}</span>}
      </span>
    </li>
  ))}
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 56px 20px 1fr;
    gap: 14px;
    align-items: start;
  }

  .timeline__time {
    padding-top: 2px;
    text-align: right;
    font-family: var(--bb-font-mono);
    font-size: var(--bb-caption-size);
    color: var(--bb-text-secondary);
  }

  .timeline__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    align-self: stretch;
  }

  .timeline__dot {
    width: 11px;
    height: 11px;
    margin-top: 4px;
    border-radius: 50%;
    background: var(--bb-teal);
  }

  .timeline__item--ongoing .timeline__dot {
    background: var(--bb-white);
    border: 2px solid var(--bb-teal);
  }

  .timeline__line {
    flex: 1;
    width: 1px;
    min-height: 46px;
    background: var(--bb-border-default);
  }

  .timeline__item:last-child .timeline__line {
    display: none;
  }

  .timeline__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-bottom: 20px;
  }

  .timeline__title {
    font-size: 0.9375rem;
    font-weight: var(--bb-weight-book);
  }

  .timeline__meta {
    font-size: 0.8125rem;
    color: var(--bb-text-secondary);
  }
</style>
