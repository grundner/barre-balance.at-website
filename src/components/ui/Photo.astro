---
/**
 * DS (UI-Kit Website): Photo. Bilder sind nie gerundet, ohne Filter.
 * Bis echte Fotos vorliegen: diagonal schraffierter Platzhalter mit Beschriftung.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Beschriftung des Platzhalters, solange kein Bild vorliegt. */
  label?: string;
  ratio?: '3/2' | '1/1' | '3/4' | '4/3' | '16/9';
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  image,
  alt = '',
  label,
  ratio = '3/2',
  sizes = '(min-width: 1200px) 600px, 100vw',
  priority = false,
  class: className,
} = Astro.props;
---

{image ? (
  <Image
    src={image}
    alt={alt}
    sizes={sizes}
    widths={[480, 800, 1200, 1600]}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class:list={['photo', className]}
    style={`aspect-ratio:${ratio}`}
  />
) : (
  <div class:list={['photo', 'photo--placeholder', className]} style={`aspect-ratio:${ratio}`}>
    {label && (
      <span class="photo__label" aria-hidden="true">
        {label}
      </span>
    )}
  </div>
)}

<style>
  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--bb-radius-0);
  }

  .photo--placeholder {
    position: relative;
    background: repeating-linear-gradient(
      135deg,
      var(--bb-grey-375) 0 7px,
      var(--bb-grey-300) 7px 14px
    );
  }

  .photo__label {
    position: absolute;
    top: 14px;
    left: 18px;
    right: 18px;
    font-family: var(--bb-font-mono);
    font-size: 0.625rem;
    color: var(--bb-grey-800);
  }
</style>
