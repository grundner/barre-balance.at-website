---
/**
 * DS: Card. Outlined, 1 px Rahmen, 2 px Radius, weiße Fläche, kein Schatten im Ruhezustand.
 * Unter dem Text steht der Barre-Akzent (48 × 2 px Teal).
 * Slots: `media`, default (Text), `actions`, `aside`.
 */
interface Props {
  overline?: string;
  title?: string;
  href?: string;
  headingLevel?: 2 | 3 | 4;
  accent?: boolean;
  class?: string;
}

const { overline, title, href, headingLevel = 3, accent = true, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const hasMedia = Astro.slots.has('media');
const hasFooter = Astro.slots.has('actions') || Astro.slots.has('aside');
---

<article class:list={['card', className]}>
  {hasMedia && (
    <div class="card__media">
      <slot name="media" />
    </div>
  )}
  <div class="card__body">
    {overline && <span class="bb-overline">{overline}</span>}
    {title && (
      <Heading class="card__title">
        {href ? (
          <a href={href} class="card__link">
            {title}
          </a>
        ) : (
          title
        )}
      </Heading>
    )}
    <div class="card__text">
      <slot />
    </div>
    {accent && <span class="bb-marker card__marker" />}
  </div>
  {hasFooter && (
    <div class="card__footer">
      <slot name="actions" />
      <span class="card__spacer" />
      <slot name="aside" />
    </div>
  )}
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: var(--bb-border);
    border-radius: var(--bb-radius);
    background: var(--bb-surface-card);
    transition: box-shadow var(--bb-dur-short) var(--bb-ease);
  }

  .card:hover {
    box-shadow: var(--bb-elev-1);
  }

  .card__media {
    overflow: hidden;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px;
    flex: 1;
  }

  .card__title {
    font-size: 1.375rem;
    font-weight: var(--bb-weight-regular);
    line-height: 1.2;
  }

  .card__link {
    color: var(--bb-text-primary);
  }

  .card__link:hover {
    color: var(--bb-teal-dark);
  }

  .card__text {
    font-size: var(--bb-body2-size);
    line-height: var(--bb-body2-line);
    color: var(--bb-text-secondary);
  }

  .card__text:empty {
    display: none;
  }

  .card__marker {
    margin-top: 6px;
  }

  .card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 0 24px 22px;
  }

  .card__spacer {
    flex: 1;
  }
</style>
