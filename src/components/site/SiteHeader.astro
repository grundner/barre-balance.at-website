---
/**
 * DS (UI-Kit Website): SiteHeader auf Basis der AppBar.
 * Sticky, 72 px, Off-White mit 8 px Blur. Aktiver Link: 2 px Teal-Linie.
 * Mobil: Menü über <details>, ohne JavaScript (WEB-Q4).
 */
import type { Site, Ui } from '../../lib/content.ts';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  site: Site;
  ui: Ui;
}

const { site, ui } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="header">
  <div class="header__bar">
    <a href="/" class="header__home" aria-label={ui.menu.home}>
      <Logo brand={site.brand} size={34} />
    </a>

    <nav class="header__nav" aria-label={ui.menu.label}>
      <ul class="header__links">
        {site.navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="header__link"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <Button href={site.headerCta.href} size="small" class="header__cta">
      {site.headerCta.label}
    </Button>

    <details class="menu">
      <summary class="menu__toggle">
        <Icon name="menu" size={26} />
        <span class="bb-visually-hidden">{ui.menu.toggle}</span>
      </summary>
      <nav class="menu__panel" aria-label={ui.menu.label}>
        <ul class="menu__links">
          {site.navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="menu__link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <Button href={site.headerCta.href} size="large" fullWidth>
          {site.headerCta.label}
        </Button>
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--bb-z-appbar);
    background: rgba(250, 250, 248, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--bb-border-default);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 36px;
    height: 72px;
    max-width: calc(var(--bb-max-xl));
    margin-inline: auto;
    padding-inline: var(--bb-container-pad-xs);
  }

  @media (min-width: 600px) {
    .header__bar {
      padding-inline: 28px;
    }
  }

  .header__home {
    display: inline-flex;
    margin-right: auto;
  }

  .header__nav,
  .header__cta {
    display: none;
  }

  @media (min-width: 900px) {
    .header__home {
      margin-right: 0;
    }

    .header__nav {
      display: block;
      flex: 1;
    }

    .header__cta {
      display: inline-flex;
    }

    .menu {
      display: none;
    }
  }

  .header__links,
  .menu__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
  }

  .header__link {
    display: inline-block;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
    font-size: var(--bb-body2-size);
    font-weight: var(--bb-weight-book);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bb-text-secondary);
    transition: var(--bb-transition-hover);
  }

  .header__link:hover {
    color: var(--bb-text-primary);
  }

  .header__link[aria-current='page'] {
    color: var(--bb-text-primary);
    border-bottom-color: var(--bb-teal);
  }

  .menu__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--bb-touch);
    height: var(--bb-touch);
    margin-right: -10px;
    color: var(--bb-text-primary);
    cursor: pointer;
    list-style: none;
  }

  .menu__toggle::-webkit-details-marker {
    display: none;
  }

  .menu__panel {
    position: absolute;
    inset: 72px 0 auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--bb-space-3);
    padding: var(--bb-space-2) var(--bb-container-pad-xs) var(--bb-space-4);
    background: var(--bb-surface-page);
    border-bottom: 1px solid var(--bb-border-default);
    box-shadow: var(--bb-elev-3);
  }

  .menu__link {
    display: flex;
    align-items: center;
    min-height: var(--bb-touch-lg);
    padding-left: var(--bb-space-2);
    border-left: 2px solid transparent;
    font-size: 1.0625rem;
    font-weight: var(--bb-weight-book);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bb-text-primary);
  }

  .menu__link[aria-current='page'] {
    border-left-color: var(--bb-teal);
  }

  .menu__link:hover {
    background: var(--bb-action-quiet-hover);
  }
</style>
