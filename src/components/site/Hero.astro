---
/**
 * Startseiten-Hero (docs/features/website.md#hero-der-startseite, Claude Design: Hero Varianten 2a).
 * Das Foto trägt vollflächig; der Text steht hell auf einem dunklen Schutzverlauf.
 */
import type { Page } from '../../lib/content.ts';
import Button from '../ui/Button.astro';
import Photo from '../ui/Photo.astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { data } = page;
---

<section class="hero" aria-labelledby="hero-titel">
  <Photo
    image={data.image}
    alt={data.imageAlt}
    label={data.imageLabel}
    focus={data.imageFocus}
    ratio="16/9"
    priority
    sizes="100vw"
    class="hero__photo"
  />
  <div class="hero__scrim"></div>
  <div class="bb-container hero__content">
    <div class="hero__text">
      {data.overline && <span class="bb-overline hero__overline">{data.overline}</span>}
      <h1 id="hero-titel" class="bb-h1 hero__title">
        {data.title}
      </h1>
      <span class="bb-marker bb-marker--wide hero__marker"></span>
      {data.lead && <p class="bb-lead hero__lead">{data.lead}</p>}
      {data.ctas.length > 0 && (
        <div class="hero__ctas">
          {data.ctas.map((cta, index) => (
            <Button
              href={cta.href}
              size="large"
              variant={index === 0 ? 'contained' : 'outlined'}
              class={index > 0 ? 'hero__cta--on-dark' : undefined}
            >
              {cta.label}
            </Button>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(88svh, 820px);
    overflow: hidden;
    background: var(--bb-ink);
  }

  .hero :global(.hero__photo) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto !important;
  }

  /*
   * Mobil liegt der Text unten, deshalb verläuft der Schutz von unten nach oben.
   * Stärker als im Design, damit weißer Text auch auf hellen Fotos AA erreicht (DS-DEV-4).
   */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      color-mix(in srgb, var(--bb-ink) 82%, transparent) 0%,
      color-mix(in srgb, var(--bb-ink) 66%, transparent) 75%,
      color-mix(in srgb, var(--bb-ink) 30%, transparent) 100%
    );
  }

  @media (min-width: 900px) {
    .hero__scrim {
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--bb-ink) 78%, transparent) 0%,
        color-mix(in srgb, var(--bb-ink) 64%, transparent) 45%,
        color-mix(in srgb, var(--bb-ink) 0%, transparent) 80%
      );
    }
  }

  .hero__content {
    position: relative;
    width: 100%;
    padding-block: var(--bb-space-10) var(--bb-space-7);
  }

  @media (min-width: 1200px) {
    .hero__content {
      padding-bottom: 120px;
    }
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--bb-space-3);
    max-width: 600px;
    color: var(--bb-white);
  }

  @media (min-width: 1200px) {
    .hero__text {
      gap: 26px;
    }
  }

  .hero__overline,
  .hero__lead {
    color: var(--bb-white);
  }

  .hero__title {
    white-space: pre-line;
  }

  .hero__marker {
    background: var(--bb-teal-light);
  }

  .hero__lead {
    max-width: 44ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: var(--bb-space-1);
  }

  .hero :global(.hero__cta--on-dark) {
    color: var(--bb-white);
    border-color: color-mix(in srgb, var(--bb-white) 60%, transparent);
  }

  .hero :global(.hero__cta--on-dark:hover) {
    background: color-mix(in srgb, var(--bb-white) 12%, transparent);
    border-color: var(--bb-white);
  }
</style>
