---
/**
 * Nächste Termine (WEB-R8): je Termin Datum, Uhrzeit, Ort, Kurs und Anfrage per E-Mail.
 * Vergangene Termine sind bereits beim Laden entfallen (WEB-R7).
 */
import type { NextSession, Site, Ui } from '../../lib/content.ts';
import { formatSessionDate } from '../../lib/dates.ts';
import { inquiryLinks } from '../../lib/inquiry.ts';
import { format } from '../../lib/text.ts';
import Button from '../ui/Button.astro';

interface Props {
  site: Site;
  ui: Ui;
  sessions: NextSession[];
  /** Kursname ausblenden, z. B. auf der Kursdetailseite. */
  hideCourse?: boolean;
}

const { site, ui, sessions, hideCourse = false } = Astro.props;
---

<ul class:list={['sessions', { 'sessions--single': hideCourse }]}>
  {sessions.map((session) => {
    const date = formatSessionDate(session.start);
    const title = session.course.data.title;
    const [email] = inquiryLinks(site.contact, ui.inquiry, {
      course: title,
      date,
      time: session.time,
    });
    return (
      <li class="session" data-course={session.course.id}>
        <time class="session__date" datetime={session.start.toISOString()}>
          {date}
        </time>
        {!hideCourse && (
          <a href={`/kurse/${session.course.id}/`} class="session__course">
            {title}
          </a>
        )}
        <span class="session__meta">
          {[
            format(ui.sessions.time, { time: session.time }),
            session.location.data.name,
            `${session.course.data.duration} ${ui.courses.minutes}`,
          ].join(' · ')}
        </span>
        {session.note && <span class="session__note">{session.note}</span>}
        {email && (
          <Button
            href={email.href}
            variant="outlined"
            data-inquiry="email"
            aria-label={`${ui.sessions.inquire}: ${title}, ${date}, ${session.time}`}
            class="session__cta"
          >
            {ui.sessions.inquire}
          </Button>
        )}
      </li>
    );
  })}
</ul>

<style>
  .sessions {
    display: grid;
    gap: var(--bb-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .sessions:not(.sessions--single) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .session {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 22px 24px;
    border: var(--bb-border);
    border-top: 2px solid var(--bb-teal);
    border-radius: var(--bb-radius);
    background: var(--bb-surface-card);
  }

  .session__date {
    font-size: 1.375rem;
    font-weight: 300;
    line-height: 1.3;
  }

  .session__course {
    font-size: 1.0625rem;
    color: var(--bb-text-primary);
    text-decoration: none;
  }

  .session__course:hover {
    color: var(--bb-text-link-hover);
  }

  .session__meta,
  .session__note {
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--bb-text-secondary);
  }

  .session :global(.session__cta) {
    margin-top: var(--bb-space-1);
  }
</style>
