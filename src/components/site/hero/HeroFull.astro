---
/**
 * Startseiten-Hero, Variante „vollflaechig“ (Claude Design: Hero Varianten 2a).
 * Das Foto trägt; der Text steht auf einem dunklen Schutzverlauf.
 */
import type { Page } from '../../../lib/content.ts';
import Photo from '../../ui/Photo.astro';
import HeroText from './HeroText.astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const wide = page.data.hero?.wide ?? {};
---

<section class="hero-full" aria-labelledby="hero-titel">
  <Photo
    image={wide.image}
    alt={wide.imageAlt}
    label={wide.imageLabel}
    ratio="16/9"
    priority
    sizes="100vw"
    class="hero-full__photo"
  />
  <div class="hero-full__scrim"></div>
  <div class="bb-container hero-full__content">
    <HeroText page={page} onDark />
  </div>
</section>

<style>
  .hero-full {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(88svh, 820px);
    overflow: hidden;
    background: var(--bb-ink);
  }

  .hero-full :global(.hero-full__photo) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto !important;
  }

  /*
   * Mobil liegt der Text unten, deshalb verläuft der Schutz von unten nach oben.
   * Stärker als im Design, damit weißer Text auch auf hellen Fotos AA erreicht (DS-DEV-4).
   */
  .hero-full__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      color-mix(in srgb, var(--bb-ink) 82%, transparent) 0%,
      color-mix(in srgb, var(--bb-ink) 66%, transparent) 75%,
      color-mix(in srgb, var(--bb-ink) 30%, transparent) 100%
    );
  }

  @media (min-width: 900px) {
    .hero-full__scrim {
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--bb-ink) 78%, transparent) 0%,
        color-mix(in srgb, var(--bb-ink) 64%, transparent) 45%,
        color-mix(in srgb, var(--bb-ink) 0%, transparent) 80%
      );
    }
  }

  .hero-full__content {
    position: relative;
    width: 100%;
    padding-block: var(--bb-space-10) var(--bb-space-7);
  }

  .hero-full__content > :global(*) {
    max-width: 600px;
  }

  @media (min-width: 1200px) {
    .hero-full__content {
      padding-bottom: 120px;
    }
  }
</style>
