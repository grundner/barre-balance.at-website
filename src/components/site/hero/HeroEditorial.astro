---
/**
 * Startseiten-Hero, Variante „editorial“ (Claude Design: Hero Varianten 2b).
 * Porträt und Detailbild; eine Teal-Linie läuft durch die Komposition.
 */
import type { Page } from '../../../lib/content.ts';
import Photo from '../../ui/Photo.astro';
import HeroText from './HeroText.astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { data } = page;
const detail = data.hero?.detail ?? {};
const caption = data.hero?.caption ?? [];
---

<section class="hero-editorial" aria-labelledby="hero-titel">
  <div class="bb-container hero-editorial__inner">
    <HeroText page={page} />
    <figure class="hero-editorial__media">
      <div class="hero-editorial__composition">
        <Photo
          image={data.image}
          alt={data.imageAlt}
          label={data.imageLabel}
          ratio="3/4"
          priority
          sizes="(min-width: 900px) 440px, 80vw"
          class="hero-editorial__portrait"
        />
        <div class="hero-editorial__detail">
          <Photo
            image={detail.image}
            alt={detail.imageAlt}
            label={detail.imageLabel}
            ratio="1/1"
            sizes="(min-width: 900px) 268px, 40vw"
          />
        </div>
        <span class="hero-editorial__line"></span>
      </div>
      {caption.length > 0 && (
        <figcaption class="hero-editorial__caption">
          {caption.map((part) => (
            <span>{part}</span>
          ))}
        </figcaption>
      )}
    </figure>
  </div>
</section>

<style>
  .hero-editorial {
    overflow: hidden;
    background: var(--bb-surface-sand);
  }

  .hero-editorial__inner {
    display: grid;
    gap: var(--bb-space-7);
    padding-block: var(--bb-space-7) var(--bb-space-9);
  }

  @media (min-width: 900px) {
    .hero-editorial__inner {
      grid-template-columns: minmax(0, 540px) minmax(0, 1fr);
      justify-content: space-between;
      align-items: center;
      gap: var(--bb-space-9);
      padding-block: 96px;
    }
  }

  .hero-editorial__media {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    /* Rechts Platz für das überlappende Detailbild. */
    padding-right: 22%;
  }

  @media (min-width: 900px) {
    .hero-editorial__media {
      width: 100%;
      max-width: 648px;
      justify-self: end;
      padding-right: 208px;
    }
  }

  .hero-editorial__composition {
    position: relative;
  }

  /* Die Linie beginnt vor dem Porträt und läuft bis zum Rand des Viewports. */
  .hero-editorial__line {
    position: absolute;
    top: 62%;
    left: -48px;
    right: -100vw;
    height: 4px;
    background: var(--bb-teal);
  }

  .hero-editorial__detail {
    position: absolute;
    top: 47%;
    right: -26%;
    width: 52%;
    border: 8px solid var(--bb-surface-sand);
  }

  @media (min-width: 900px) {
    .hero-editorial__detail {
      right: -230px;
      width: 268px;
    }
  }

  .hero-editorial__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    font-family: var(--bb-font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bb-text-secondary);
  }
</style>
