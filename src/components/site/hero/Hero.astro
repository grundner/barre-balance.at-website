---
/**
 * Startseiten-Hero in der gewählten Variante (docs/features/website.md#hero-der-startseite).
 * Entscheidung zwischen den Varianten offen (OQ-18).
 */
import type { Page } from '../../../lib/content.ts';
import type { HeroVariant } from '../../../lib/hero.ts';
import HeroEditorial from './HeroEditorial.astro';
import HeroFull from './HeroFull.astro';

interface Props {
  page: Page;
  /** Überschreibt die Variante aus dem Inhalt (nur Dev-Vorschau). */
  variant?: HeroVariant;
}

const { page, variant = page.data.hero?.variant } = Astro.props;
---

{variant === 'vollflaechig' ? <HeroFull page={page} /> : <HeroEditorial page={page} />}
