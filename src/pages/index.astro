---
import BlogCard from '../components/site/BlogCard.astro';
import CourseCard from '../components/site/CourseCard.astro';
import Hero from '../components/site/Hero.astro';
import InquiryActions from '../components/site/InquiryActions.astro';
import NextSessionList from '../components/site/NextSessionList.astro';
import Testimonials from '../components/site/Testimonials.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCourses,
  getNextSessions,
  getPage,
  getPosts,
  getSite,
  getTestimonials,
  getUi,
} from '../lib/content.ts';

const [site, ui, page, courses, sessions, testimonials, posts] = await Promise.all([
  getSite(),
  getUi(),
  getPage('home'),
  getCourses(),
  getNextSessions(),
  getTestimonials(),
  getPosts(),
]);
const { data } = page;

function section(key: string) {
  const value = data.sections[key];
  if (!value) throw new Error(`content/pages/home.md: sections.${key} fehlt`);
  return value;
}

const sessionsSection = section('sessions');
const coursesSection = section('courses');
const philosophySection = section('philosophy');
const testimonialsSection = section('testimonials');
const blogSection = section('blog');
const inquirySection = section('inquiry');
---

<BaseLayout title={data.seoTitle ?? data.title} description={data.description} isHome>
  <Hero page={page} />

  {sessions.length > 0 && (
    <Section
      id="termine"
      tone="white"
      overline={sessionsSection.overline}
      title={sessionsSection.title}
      lead={sessionsSection.lead}
    >
      <NextSessionList site={site} ui={ui} sessions={sessions} />
    </Section>
  )}

  <Section
    id="kurse"
    overline={coursesSection.overline}
    title={coursesSection.title}
    lead={coursesSection.lead}
  >
    <div class="bb-grid">
      {courses.slice(0, 3).map((course) => (
        <CourseCard course={course} ui={ui} />
      ))}
    </div>
    {coursesSection.cta && (
      <div>
        <Button href={coursesSection.cta.href} variant="outlined" endIcon="arrow-forward">
          {coursesSection.cta.label}
        </Button>
      </div>
    )}
  </Section>

  <Section
    id="philosophie"
    tone="sand"
    overline={philosophySection.overline}
    title={philosophySection.title}
    lead={philosophySection.lead}
  >
    {philosophySection.cta && (
      <div>
        <Button href={philosophySection.cta.href} variant="outlined" endIcon="arrow-forward">
          {philosophySection.cta.label}
        </Button>
      </div>
    )}
  </Section>

  {testimonials.length > 0 && (
    <Section
      id="stimmen"
      tone="white"
      overline={testimonialsSection.overline}
      title={testimonialsSection.title}
      lead={testimonialsSection.lead}
    >
      <Testimonials testimonials={testimonials} />
    </Section>
  )}

  {posts.length > 0 && (
    <Section
      id="blog"
      overline={blogSection.overline}
      title={blogSection.title}
      lead={blogSection.lead}
    >
      <div class="bb-grid">
        {posts.slice(0, 3).map((post) => (
          <BlogCard post={post} ui={ui} headingLevel={3} />
        ))}
      </div>
      {blogSection.cta && (
        <div>
          <Button href={blogSection.cta.href} variant="outlined" endIcon="arrow-forward">
            {blogSection.cta.label}
          </Button>
        </div>
      )}
    </Section>
  )}

  <Section
    id="anfrage"
    tone="sand"
    overline={inquirySection.overline}
    title={inquirySection.title}
    lead={inquirySection.lead}
  >
    <InquiryActions site={site} ui={ui} />
  </Section>
</BaseLayout>
