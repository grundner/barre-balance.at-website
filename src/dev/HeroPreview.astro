---
/**
 * Nur in der Entwicklung unter /ds/hero/<variante>/ erreichbar (astro.config.mjs).
 * Vergleich der Hero-Varianten der Startseite, unabhängig von der Variante im Inhalt (OQ-18).
 */
import Hero from '../components/site/hero/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, getUi } from '../lib/content.ts';
import { HERO_VARIANTS, type HeroVariant } from '../lib/hero.ts';

export function getStaticPaths() {
  return HERO_VARIANTS.map((variant) => ({ params: { variant } }));
}

const variant = Astro.params.variant as HeroVariant;
const [ui, page] = await Promise.all([getUi(), getPage('home')]);
---

<BaseLayout title={`Hero ${variant}`} description="Dev-Vorschau">
  <Hero page={page} ui={ui} variant={variant} />
</BaseLayout>
