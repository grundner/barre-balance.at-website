---
/** Redaktionelle Textseite: Kopf und Markdown-Fließtext aus content/pages/<id>.md. */
import { render } from 'astro:content';
import PageHeader from '../components/site/PageHeader.astro';
import { getPage, getUi } from '../lib/content.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  pageId: string;
}

const { pageId } = Astro.props;
const [ui, page] = await Promise.all([getUi(), getPage(pageId)]);
const { Content } = await render(page);
---

<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.description}>
  <PageHeader page={page} ui={ui} width="text" />
  <div class="bb-container bb-container--text text-page">
    <div class="bb-prose">
      <Content />
    </div>
    <slot />
  </div>
</BaseLayout>

<style>
  .text-page {
    display: flex;
    flex-direction: column;
    gap: var(--bb-space-6);
    padding-block: var(--bb-space-4) var(--bb-space-10);
  }
</style>
