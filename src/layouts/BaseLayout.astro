---
/**
 * Grundlayout aller Seiten: Metadaten (WEB-Q5), Indexierung (WEB-R4), Header und Footer.
 */
import '../styles/global.css';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import { getSite, getUi } from '../lib/content.ts';

interface Props {
  title: string;
  description: string;
  /** Auf der Startseite steht nur der Markenname im Titel. */
  isHome?: boolean;
  ogImage?: string;
  article?: { published: Date; modified?: Date };
}

const { title, description, isHome = false, ogImage = '/og-default.png', article } = Astro.props;
const [site, ui] = await Promise.all([getSite(), getUi()]);

const pageTitle = isHome ? `${site.brand} · ${title}` : `${title} · ${site.brand}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!site.indexing && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={site.lang.replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && (
      <meta property="article:published_time" content={article.published.toISOString()} />
    )}
    {article?.modified && (
      <meta property="article:modified_time" content={article.modified.toISOString()} />
    )}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.brand} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FAFAF8" />
  </head>
  <body>
    <a href="#inhalt" class="skip-link">
      {ui.skipLink}
    </a>
    <SiteHeader site={site} ui={ui} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <SiteFooter site={site} ui={ui} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: var(--bb-z-tooltip);
    padding: 10px 16px;
    background: var(--bb-ink);
    color: var(--bb-text-on-dark);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
    color: var(--bb-text-on-dark);
  }

  main:focus {
    outline: none;
  }
</style>
